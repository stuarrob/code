# ETFTrader environment config — Windows. Copy to `.env` and fill secrets.
DATA_DIR=C:/Users/stuar/trade_data/ETFTrader
RAW_DATA_DIR=C:/Users/stuar/trade_data/ETFTrader/raw
PROCESSED_DATA_DIR=C:/Users/stuar/trade_data/ETFTrader/processed
LOG_DIR=C:/Users/stuar/trade_data/ETFTrader/logs

IB_HOST=127.0.0.1
IB_PORT=4002          # 4002 = paper (SAFE) | 4001 = live
IB_CLIENT_ID=1

DATABENTO_API_KEY=
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_USER=woostu@mac.com
# For iCloud SMTP you MUST use an app-specific password from
# appleid.apple.com -> Sign-In & Security -> App-Specific Passwords.
# Your normal Apple ID password will fail authentication.
SMTP_PASSWORD=
ALERT_EMAIL_TO=woostu@mac.com

# Telegram Bot notifications via the official Bot API.
# One-time signup:
#   1. In Telegram, message @BotFather and send /newbot; follow the prompts.
#   2. BotFather replies with a token like 123456789:AAH-lots-of-random-chars.
#      That's TELEGRAM_TOKEN.
#   3. In Telegram, open a chat with your new bot and tap START (or send /start
#      or any message). This creates the chat.
#   4. Fetch https://api.telegram.org/bot<TOKEN>/getUpdates and look for
#      "chat":{"id":<NUMBER>. That's TELEGRAM_CHAT_ID.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

MAX_PORTFOLIO_SIZE=20
MIN_POSITION_SIZE=0.02
MAX_POSITION_SIZE=0.15
RISK_AVERSION=1.5
ROBUSTNESS_PENALTY=0.7
TURNOVER_PENALTY=0.2
